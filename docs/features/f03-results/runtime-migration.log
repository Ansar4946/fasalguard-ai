query: CREATE INDEX idx_guideline_approval_history ON guideline_approvals(guideline_id,created_at)
query: CREATE FUNCTION prevent_approval_mutation() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'guideline approval history is immutable'; END $$
