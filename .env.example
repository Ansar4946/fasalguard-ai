# Server-only URL used by Next.js route handlers and proxy. Do not prefix with NEXT_PUBLIC.
FASALGUARD_API_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3000
# Server-side geocoding credentials. Google is preferred when configured;
# Geoapify remains the fallback. Never expose these with NEXT_PUBLIC_ prefixes.
GOOGLE_MAPS_API_KEY=
GEOAPIFY_API_KEY=
PASSWORD_SETUP_TTL_MINUTES=30
# Server-side SMTP only. Never use NEXT_PUBLIC_ variables for credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FasalGuard AI <no-reply@example.com>
# Explicit opt-in for the AMIS scraper. Confirm source permission and terms before enabling.
AMIS_SYNC_ENABLED=false

# Server-side Roboflow credentials and crop-specific model registry.
# Universe URL example: /agriculture/wheat-disease-detection-zsn0p -> model id below.
VISION_PROVIDER=roboflow
ROBOFLOW_BASE_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_WHEAT_MODEL_ID=wheat-disease-detection-zsn0p
ROBOFLOW_WHEAT_MODEL_VERSION=1
ROBOFLOW_WHEAT_MODEL_TASK=classification
# Populate these only after the forked rice dataset has a completed, deployed model.
ROBOFLOW_RICE_MODEL_ID=
ROBOFLOW_RICE_MODEL_VERSION=
ROBOFLOW_RICE_MODEL_TASK=classification
