# Server-only URL used by Next.js route handlers and proxy. Do not prefix with NEXT_PUBLIC.
FASALGUARD_API_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3000
# Server-side geocoding credentials. Google is preferred when configured;
# Geoapify remains the fallback. Never expose these with NEXT_PUBLIC_ prefixes.
GOOGLE_MAPS_API_KEY=
GEOAPIFY_API_KEY=
PASSWORD_SETUP_TTL_MINUTES=30
# Server-side SMTP only. Never use NEXT_PUBLIC_ variables for credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FasalGuard AI <no-reply@example.com>
