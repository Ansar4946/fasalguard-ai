  crop_scans              crop_scans?               @relation(fields: [scan_id], references: [id], onUpdate: NoAction)
  community_verifications community_verifications[]
  outbreak_members        outbreak_members[]

  @@index([crop_id, condition_family, reported_at(sort: Desc)], map: "idx_community_report_match")
  @@index([private_location], map: "idx_community_report_private_gist", type: Gist)
}

