datasource db {
  provider = "postgresql"
}

model action_plan_steps {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action_plan_id       String               @db.Uuid
  type                 String               @db.VarChar(32)
  instruction          String
  display_order        Int
  source_guideline_id  String               @db.Uuid
  source_field         String               @db.VarChar(48)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  version              Int                  @default(1)
  action_plans         action_plans         @relation(fields: [action_plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatment_guidelines treatment_guidelines @relation(fields: [source_guideline_id], references: [id], onUpdate: NoAction)

  @@index([action_plan_id, display_order], map: "idx_action_plan_steps_order")
}

model action_plans {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scan_id              String               @db.Uuid
  guideline_id         String               @db.Uuid
  guideline_version    Int
  created_for_user_id  String               @db.Uuid
  severity             String               @db.VarChar(16)
  status               String               @default("ACTIVE") @db.VarChar(24)
  generated_at         DateTime             @db.Timestamptz(6)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  version              Int                  @default(1)
  action_plan_steps    action_plan_steps[]
  users                users                @relation(fields: [created_for_user_id], references: [id], onUpdate: NoAction)
  treatment_guidelines treatment_guidelines @relation(fields: [guideline_id], references: [id], onUpdate: NoAction)
  crop_scans           crop_scans           @relation(fields: [scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  farm_interventions   farm_interventions[]

  @@index([scan_id, created_at(sort: Desc)], map: "idx_action_plan_scan_created")
}

model ai_interactions {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scan_id               String?     @db.Uuid
  user_id               String      @db.Uuid
  purpose               String      @db.VarChar(40)
  provider              String      @db.VarChar(40)
  model_id              String      @db.VarChar(160)
  model_version         String      @db.VarChar(80)
  prompt_version        String      @db.VarChar(40)
  input_data            Json
  output_data           Json
  raw_provider_response Json
  status                String      @db.VarChar(24)
  failure_code          String?     @db.VarChar(80)
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @default(now()) @db.Timestamptz(6)
  version               Int         @default(1)
  crop_scans            crop_scans? @relation(fields: [scan_id], references: [id], onUpdate: NoAction)
  users                 users       @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([scan_id, created_at(sort: Desc)], map: "idx_ai_interactions_scan_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analytics_events {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
