# Development placeholders only. Never reuse these values in production.
NODE_ENV=development
PROCESS_ROLE=all
PORT=4000
DATABASE_URL=postgresql://fasalguard:change-me@localhost:5432/fasalguard
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
METRICS_ENABLED=true
# Required in production. Monitoring sends Authorization: Bearer <token>.
METRICS_TOKEN=
# Optional Sentry-compatible DSN. Events contain sanitized technical context only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=262144
SIGNED_URL_TTL_SECONDS=300
ENFORCE_FIELD_WITHIN_FARM=true
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=fasalguard-api
JWT_AUDIENCE=fasalguard-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PROVIDER=development
OBJECT_STORAGE_PROVIDER=mock
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_CACHE_TTL_SECONDS=900
VISION_PROVIDER=self-hosted
SELF_HOSTED_VISION_URL=http://localhost:8000
ROBOFLOW_BASE_URL=https://detect.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_MODEL_VERSION=
VISION_MINIMUM_CONFIDENCE=0.65
VISION_EXPERT_REVIEW_BELOW=0.85
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
PUSH_PROVIDER=development
# Base64-encoded Firebase service-account JSON. Keep empty in development and never expose it to clients.
FIREBASE_SERVICE_ACCOUNT_BASE64=
PUSH_TOKEN_STALE_DAYS=90
ASSISTANT_PROVIDER=fake
SPEECH_PROVIDER=fake
QWEN_STT_MODEL=qwen-audio-asr
QWEN_TTS_MODEL=qwen-tts
SATELLITE_MAX_CLOUD_COVERAGE=30
GEOSPATIAL_AI_URL=http://localhost:8000
SATELLITE_MONITORING_INTERVAL_HOURS=8
SATELLITE_PROVIDER_REQUESTS_PER_MINUTE=30
