# Development placeholders only. Never reuse these values in production.
NODE_ENV=development
PROCESS_ROLE=all
PORT=4000
DATABASE_URL=postgresql://fasalguard:change-me@localhost:5432/fasalguard
DATABASE_SSL=false
# Production requires DATABASE_SSL=true. Set to true only to acknowledge a private-network
# database that cannot terminate TLS (documented override; avoid).
ALLOW_PLAINTEXT_DATABASE=false
# Express 'trust proxy': false (default) or the number of reverse-proxy hops in front of the API.
# Only then is X-Forwarded-For used for the client IP in rate limiting. 'true' is dev-only.
TRUST_PROXY=false
# Shared secret for service-to-service calls (platform-api hand-off). Production: 32+ random chars.
INTERNAL_SERVICE_TOKEN=
# Per-user (or per-IP when anonymous) request ceiling per minute. In-memory, per API instance.
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
METRICS_ENABLED=true
# Required in production. Monitoring sends Authorization: Bearer <token>.
METRICS_TOKEN=
# Optional Sentry-compatible DSN. Events contain sanitized technical context only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=262144
SIGNED_URL_TTL_SECONDS=300
ENFORCE_FIELD_WITHIN_FARM=true
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=fasalguard-api
JWT_AUDIENCE=fasalguard-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PROVIDER=development
WEB_APP_URL=http://localhost:3000
PASSWORD_SETUP_TTL_MINUTES=30
# SMTP credentials remain server-side. Use a dedicated transactional email account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FasalGuard AI <no-reply@example.com>
OBJECT_STORAGE_PROVIDER=mock
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Directory for OBJECT_STORAGE_PROVIDER=local-disk.
MEDIA_LOCAL_DIR=/data/media
# Public URL of this API (production: public https, not localhost).
API_PUBLIC_URL=http://localhost:4000/api/v1
# Stripe is treated as enabled once any key is set; production then requires all three.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
SENTINEL_HUB_AUTH_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Production Open-Meteo requires a commercial key and https://customer-api.open-meteo.com.
OPEN_METEO_API_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org
OPENWEATHERMAP_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_ALERT_MIN_INTERVAL_HOURS=12
VISION_PROVIDER=self-hosted
SELF_HOSTED_VISION_URL=http://localhost:8000
ROBOFLOW_BASE_URL=https://detect.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_MODEL_VERSION=
ROBOFLOW_MODEL_TASK=classification
ROBOFLOW_WHEAT_MODEL_ID=
ROBOFLOW_WHEAT_MODEL_VERSION=
ROBOFLOW_WHEAT_MODEL_TASK=classification
ROBOFLOW_RICE_MODEL_ID=
ROBOFLOW_RICE_MODEL_VERSION=
ROBOFLOW_RICE_MODEL_TASK=classification
VISION_MINIMUM_CONFIDENCE=0.65
VISION_EXPERT_REVIEW_BELOW=0.85
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
PUSH_PROVIDER=development
# Base64-encoded Firebase service-account JSON. Keep empty in development and never expose it to clients.
FIREBASE_SERVICE_ACCOUNT_BASE64=
PUSH_TOKEN_STALE_DAYS=90
ASSISTANT_PROVIDER=fake
ASSISTANT_TIMEOUT_MS=20000
ASSISTANT_MAX_CONTEXT_MESSAGES=10
ASSISTANT_RETRIEVAL_LIMIT=4
# Dawai Check (pesticide label screening). Off by default: the routes do not exist until enabled.
DAWAI_CHECK_ENABLED=false
# tesseract (local OCR, default) | openai-compatible (hosted vision, falls back to tesseract) | fake (tests only)
LABEL_READER_PROVIDER=tesseract
# eng only by default; eng+urd needs urd.traineddata in assets/tessdata
LABEL_OCR_LANGS=eng
LABEL_VISION_BASE_URL=
LABEL_VISION_API_KEY=
LABEL_VISION_MODEL=
SPEECH_PROVIDER=fake
# Empty follows SPEECH_PROVIDER for speech-to-text; or assemblyai.
SPEECH_STT_PROVIDER=
ASSEMBLYAI_API_KEY=
QWEN_STT_MODEL=qwen-audio-asr
QWEN_TTS_MODEL=qwen-tts
# Real F08 provider candidate. Set SPEECH_PROVIDER=azure only after credentials
# and consented Urdu/Hindi/English evaluation data are available.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEECH_PROVIDER_TIMEOUT_MS=20000

# F09 application contract. Keep disabled until a Pakistan gateway contract is selected.
USSD_ENABLED=false
USSD_DEMO_ENABLED=false
USSD_GATEWAY=contract-test
USSD_CALLBACK_SECRET=
USSD_SESSION_TTL_SECONDS=300
USSD_PIN_MAX_ATTEMPTS=5
USSD_PIN_LOCK_SECONDS=900
USSD_MAX_AMOUNT_MINOR=100000000

# Gemini Farm Brain. Use google-ai with a server-side key for demos, or Vertex workload identity in production.
FARM_BRAIN_PROVIDER=fake
GEMINI_TRANSPORT=google-ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Optional short-lived injected token for non-GCP staging only; prefer workload identity on Vertex.
GOOGLE_ACCESS_TOKEN=
# Optional per-million-token pricing for cost estimates. Leave unset to disable estimates.
GEMINI_INPUT_PRICE_PER_MILLION_TOKENS=
GEMINI_OUTPUT_PRICE_PER_MILLION_TOKENS=
SATELLITE_MAX_CLOUD_COVERAGE=30
SATELLITE_MIN_VALID_PIXEL_PERCENTAGE=20
GEOSPATIAL_AI_URL=http://localhost:8000
AMIS_SYNC_ENABLED=false
AMIS_SCRAPE_TIMEOUT_MS=120000
MARKET_CACHE_TTL_SECONDS=3600
MARKET_MAX_AGE_DAYS=1
# Enable only after confirming permission to automate access to AMIS.
AMIS_SCRAPER_ENABLED=false
AMIS_BASE_URL=http://www.amis.pk
AMIS_TIMEOUT_SECONDS=30
AMIS_REQUEST_DELAY_SECONDS=1
SATELLITE_MONITORING_INTERVAL_HOURS=8
SATELLITE_PROVIDER_REQUESTS_PER_MINUTE=30
