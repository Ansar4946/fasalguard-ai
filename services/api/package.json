{
  "name": "@fasalguard/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testRegex=\\.integration-spec\\.ts$",
    "test:cov": "jest --coverage",
    "migration:run": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:run",
    "migration:run:prod": "typeorm -d dist/infrastructure/database/data-source.js migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:show",
    "db:inspect": "prisma db pull",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "ali-oss": "^6.23.0",
    "argon2": "^0.44.0",
    "bullmq": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "ioredis": "^5.11.1",
    "joi": "^18.0.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.29",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "29.5.14",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "29.7.0",
    "prettier": "^3.7.4",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  }
}
