# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend outputs
services/api/dist/
services/api/coverage/

# Python caches and local environments
.wapor-credentials/
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/*.pyc

# F08 speech evaluation inputs are consented private research data. Keep the
# manifest, recordings, and any per-sample output outside version control.
/private/f08-speech/
/docs/features/f08-results/private-*

# Firebase service-account private keys must never be committed
*firebase-adminsdk*.json
*service-account*.json

# Firebase client config (contains an API key); keep per-environment, never commit
google-services.json
GoogleService-Info.plist
