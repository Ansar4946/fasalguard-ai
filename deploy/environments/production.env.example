NODE_ENV=production
NODE_EXTRA_CA_CERTS=/run/certs/rds-ca.pem
PORT=4000
DATABASE_URL=
DATABASE_SSL=true
REDIS_URL=
LOG_LEVEL=info
ENABLE_SWAGGER=false
CORS_ORIGINS=https://app.fasalguard.example
WEB_APP_URL=
API_PUBLIC_URL=
JWT_ACCESS_SECRET=
OTP_PROVIDER=production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OBJECT_STORAGE_PROVIDER=alibaba
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
METRICS_ENABLED=true
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
QWEN_API_KEY=
PUSH_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=
SELF_HOSTED_VISION_URL=http://ai-service:8000
GEOSPATIAL_AI_URL=http://ai-service:8000
INTERNAL_SERVICE_TOKEN=
SATELLITE_PLATFORM_ENABLED=false
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
OPEN_METEO_API_KEY=
IRRIGATION_WEATHER_API_KEY=
FARM_BRAIN_PROVIDER=gemini
GEMINI_TRANSPORT=vertex
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# F07 core API/worker. Enable automated AMIS only after operator permission.
AMIS_SYNC_ENABLED=false
AMIS_BASE_URL=http://www.amis.pk
AMIS_TIMEOUT_SECONDS=30
AMIS_REQUEST_DELAY_SECONDS=1
MARKET_CACHE_TTL_SECONDS=3600
MARKET_MAX_AGE_DAYS=1
SPEECH_PROVIDER=azure
AZURE_SPEECH_KEY=replace-with-secret-manager-value
AZURE_SPEECH_REGION=replace-with-deployment-region
SPEECH_PROVIDER_TIMEOUT_MS=20000
USSD_ENABLED=false
USSD_DEMO_ENABLED=false
USSD_GATEWAY=contract-test
USSD_CALLBACK_SECRET=
USSD_SESSION_TTL_SECONDS=300
USSD_PIN_MAX_ATTEMPTS=5
USSD_PIN_LOCK_SECONDS=900
USSD_MAX_AMOUNT_MINOR=100000000
