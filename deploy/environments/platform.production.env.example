# Supply outside source control. Values intentionally absent.
NODE_ENV=production
# F06 remains blocked; production startup rejects enabling it until release gates are resolved.
OFFLINE_SYNC_ENABLED=false
# Include sslmode=verify-full and sslrootcert=/run/certs/rds-ca.pem in the URL.
DATABASE_URL=
# Use rediss:// with certificate verification; distinct cache/broker namespaces.
REDIS_URL=
PLATFORM_CELERY_BROKER_URL=
JWT_ACCESS_SECRET=
JWT_ISSUER=fasalguard-api
JWT_AUDIENCE=fasalguard-clients
LOG_LEVEL=info
MEDIA_LOCAL_DIR=/data/media
SATELLITE_PLATFORM_ENABLED=false
SATELLITE_MAX_PIXELS=1000000
WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_MAX_STALE_SECONDS=3600
IRRIGATION_MAX_DAYS=180
IRRIGATION_RUN_LIMIT_PER_HOUR=10
IRRIGATION_WEATHER_API_KEY=
WAPOR_ENABLED=false
CORE_API_INTERNAL_URL=http://api:4000/api/v1
INTERNAL_SERVICE_TOKEN=
# F01 platform route/storage handoff is not production verified. Core scan routes remain active.

# F07: automated AMIS access requires operator permission; no credentials are embedded.
AMIS_SYNC_ENABLED=false
AMIS_BASE_URL=http://www.amis.pk
AMIS_TIMEOUT_SECONDS=30
AMIS_REQUEST_DELAY_SECONDS=1
MARKET_CACHE_TTL_SECONDS=3600
# Pakistan calendar days; holiday/trading-day policy is not inferred.
MARKET_MAX_AGE_DAYS=1
