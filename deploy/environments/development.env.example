NODE_ENV=development
PROCESS_ROLE=all
PORT=4000
DATABASE_URL=postgresql://fasalguard:local-fasalguard-password@postgres:5432/fasalguard
DATABASE_SSL=false
REDIS_URL=redis://redis:6379
LOG_LEVEL=debug
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-development-secret-at-least-32-characters
OTP_PROVIDER=development
OBJECT_STORAGE_PROVIDER=mock
METRICS_ENABLED=true
METRICS_TOKEN=
SELF_HOSTED_VISION_URL=http://geospatial-ai:8000
GEOSPATIAL_AI_URL=http://geospatial-ai:8000
