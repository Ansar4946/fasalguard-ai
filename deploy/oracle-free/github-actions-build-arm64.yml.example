# OPTIONAL: build the five arm64 images on GitHub (QEMU) instead of on the VM, then pull them on the VM.
# To use: copy to .github/workflows/build-arm64.yml in YOUR repository, set the repository variable
# DOMAIN (Settings > Secrets and variables > Actions > Variables), push, run "Build arm64 images".
# Images land in ghcr.io/<owner>/fasalguard-oracle-<service>:<tag>. On the VM:
#   echo "<github token with read:packages>" | docker login ghcr.io -u <github-user> --password-stdin
#   for s in api worker web platform-api geospatial-ai; do
#     docker pull ghcr.io/<owner>/fasalguard-oracle-$s:<tag>
#     docker tag  ghcr.io/<owner>/fasalguard-oracle-$s:<tag> fasalguard-oracle/$s:<tag>
#   done
#   # set IMAGE_TAG=<tag> in .env, then: scripts/deploy.sh --no-build
# NOT RUN: this file has not been executed. QEMU builds of the Next.js and Python images are slow
# (expect 30-60 min); a native arm64 runner is much faster if you have one.
name: Build arm64 images
on:
  workflow_dispatch:
    inputs:
      tag:
        description: Immutable image tag (for example 2026-10-16-1)
        required: true
permissions:
  contents: read
  packages: write
jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - { name: api, context: services/api, file: services/api/Dockerfile, target: production }
          - { name: worker, context: services/api, file: services/api/Dockerfile, target: worker }
          - { name: platform-api, context: services/platform-api, file: deploy/oracle-free/docker/platform-api.Dockerfile, target: production }
          - { name: geospatial-ai, context: services/geospatial-ai, file: deploy/oracle-free/docker/geospatial-ai.Dockerfile, target: "" }
          - { name: web, context: ".", file: deploy/oracle-free/docker/web.Dockerfile, target: "" }
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-qemu-action@v3
        with: { platforms: arm64 }
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/build-push-action@v6
        with:
          context: ${{ matrix.context }}
          file: ${{ matrix.file }}
          target: ${{ matrix.target }}
          platforms: linux/arm64
          push: true
          build-args: |
            STORAGE_UPLOAD_ORIGINS=https://${{ vars.DOMAIN }}
          tags: ghcr.io/${{ github.repository_owner }}/fasalguard-oracle-${{ matrix.name }}:${{ inputs.tag }}
          cache-from: type=gha,scope=${{ matrix.name }}
          cache-to: type=gha,mode=max,scope=${{ matrix.name }}
