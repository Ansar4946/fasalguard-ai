# Fasal Guard - Oracle Always Free single-VM deployment: environment template.
# Copy to .env (or run scripts/gen-secrets.sh, which does it for you), then fill in the blanks.
# NEVER commit .env. Every value below is either empty (you must fill it) or a non-secret default.
# Lines marked [GENERATED] are filled automatically by scripts/gen-secrets.sh.

# ---------------------------------------------------------------- identity of the deployment
# Public domain WITHOUT scheme, for example farm.example.com. DNS A record must point to the VM.
DOMAIN=
# E-mail Let's Encrypt uses for expiry warnings.
ACME_EMAIL=
# Tag for locally built images (change per release so you can roll back).
IMAGE_TAG=local

# ---------------------------------------------------------------- generated secrets
# [GENERATED] Postgres password for the `fasalguard` database role (hex only, URL safe).
POSTGRES_PASSWORD=
# [GENERATED] Redis password (hex only, URL safe).
REDIS_PASSWORD=
# [GENERATED] JWT signing secret; production guard needs >= 48 chars (generator gives 96 hex).
JWT_ACCESS_SECRET=
# [GENERATED] Shared secret for web/api/platform service calls; production guard needs >= 32 chars.
INTERNAL_SERVICE_TOKEN=
# [GENERATED] Bearer token for the /metrics endpoint (required whenever METRICS_ENABLED=true in production).
METRICS_TOKEN=
# [GENERATED] Only used if USSD_ENABLED=true (production guard needs >= 32 chars).
USSD_CALLBACK_SECRET=

# ---------------------------------------------------------------- runtime mode (READ THE GUIDE)
# development = "pilot mode": required for OBJECT_STORAGE_PROVIDER=local-disk, because the API refuses
#   local-disk when NODE_ENV=production (media.module.ts), and platform-api demands sslmode=verify-full
#   Postgres and rediss:// in production. The production guards in environment.ts are then NOT enforced.
# production = full guards. Only possible with real Alibaba OSS (OBJECT_STORAGE_PROVIDER=alibaba plus the
#   four OSS_* values), TLS-verified Postgres, rediss:// Redis, SMTP, a commercial Open-Meteo key (or
#   WEATHER_PROVIDER=openweathermap + key), a non-fake assistant and speech provider, PUSH_PROVIDER=firebase
#   with credentials, and Gemini. This kit does not provision the TLS endpoints for Postgres/Redis.
API_NODE_ENV=development
# Plain-text Postgres/Redis on the internal Docker network. The API's production override name is
# ALLOW_PLAINTEXT_DATABASE (justification: network is `internal: true`, no host port, single VM).
DATABASE_SSL=false
ALLOW_PLAINTEXT_DATABASE=true
# Number of reverse proxies in front of the API (Caddy = 1). Never `true` in production.
TRUST_PROXY=1
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120
METRICS_ENABLED=true
# Optional error tracking: authenticated HTTPS DSN, or empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=oracle-free

# ---------------------------------------------------------------- e-mail (account / password-setup mail)
# Required to deliver password-setup mail. Use any SMTP provider (free tiers exist).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# production-safe: the "development" OTP adapter must stay off.
OTP_PROVIDER=production

# ---------------------------------------------------------------- object storage
# local-disk stores uploads on the `media_data` Docker volume (single VM, no redundancy; back it up).
OBJECT_STORAGE_PROVIDER=local-disk
# Only for OBJECT_STORAGE_PROVIDER=alibaba (the one non-local provider the code supports).
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------- AI / assistant / farm brain
# Must be a VALID key: the key in the repo history was invalid and is rotated. Without it the
# assistant, Farm Brain and investigations return provider errors.
ASSISTANT_PROVIDER=gemini
FARM_BRAIN_PROVIDER=gemini
GEMINI_TRANSPORT=google-ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Only for GEMINI_TRANSPORT=vertex.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Only if ASSISTANT_PROVIDER=qwen or SPEECH_PROVIDER=qwen.
QWEN_API_KEY=

# ---------------------------------------------------------------- speech (voice notes / TTS)
# fake = no real speech. Pick azure (+ key and region) or qwen for real text-to-speech/transcription.
SPEECH_PROVIDER=fake
# Empty = follow SPEECH_PROVIDER, or assemblyai for speech-to-text.
SPEECH_STT_PROVIDER=
ASSEMBLYAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------------------------------------------------------------- push notifications
# firebase = real delivery (base64 of the Firebase service-account JSON). The "development" adapter
# marks unsent messages SENT, so it is not used. Empty credentials = push is reported as unconfigured.
PUSH_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------------------------------------------------------------- weather
# Web cutover to platform-api weather routes (migration 1755000039000 ships in the migrate step).
WEATHER_PLATFORM_ENABLED=true
WEATHER_PROVIDER=open-meteo
# Public endpoint is free but NON-COMMERCIAL only. For commercial use set the customer endpoint
# https://customer-api.open-meteo.com plus OPEN_METEO_API_KEY.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
IRRIGATION_WEATHER_API_KEY=
# Only if WEATHER_PROVIDER=openweathermap.
OPENWEATHERMAP_API_KEY=

# ---------------------------------------------------------------- satellite
# Cutover flag: true routes satellite via platform-api (public EarthSearch data, no key) and turns off
# the legacy Nest dispatcher. Keep false until you have smoke-tested it; legacy path needs Sentinel Hub.
SATELLITE_PLATFORM_ENABLED=false
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ---------------------------------------------------------------- crop vision (F01)
# self-hosted needs reviewed ONNX weights mounted in services/geospatial-ai/models (not in the repo).
# roboflow needs the key and model ids below.
VISION_PROVIDER=self-hosted
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_MODEL_VERSION=
ROBOFLOW_WHEAT_MODEL_ID=
ROBOFLOW_WHEAT_MODEL_VERSION=
ROBOFLOW_RICE_MODEL_ID=
ROBOFLOW_RICE_MODEL_VERSION=

# ---------------------------------------------------------------- market (AMIS)
# Enable only with the operator's permission to automate AMIS access.
AMIS_SYNC_ENABLED=false
AMIS_BASE_URL=http://www.amis.pk

# ---------------------------------------------------------------- USSD / billing
# No real USSD gateway adapter exists in code (only the test-only "contract-test"). Keep both false.
USSD_ENABLED=false
USSD_DEMO_ENABLED=false
# Billing is enabled when ANY Stripe key is set; production then needs all three. Leave empty to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- web geocoding (server-side only)
GOOGLE_MAPS_API_KEY=
GEOAPIFY_API_KEY=

# ---------------------------------------------------------------- backups (used by scripts/backup.sh)
# Directory on the VM for dated backups (use an attached block volume or off-box sync for safety).
BACKUP_DIR=/var/backups/fasalguard
BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------- Dawai Check (pesticide label screening)
# DPP lists (banned ingredients, banned pre-mixtures, Form-16 notified products) are loaded by the seed step.
DAWAI_CHECK_ENABLED=true
# tesseract = local OCR with bundled English data (default). openai-compatible needs the three LABEL_VISION_* values.
LABEL_READER_PROVIDER=tesseract
LABEL_OCR_LANGS=eng
LABEL_VISION_BASE_URL=
LABEL_VISION_API_KEY=
LABEL_VISION_MODEL=
# Web build-time flags (baked into the web image by `next build`).
NEXT_PUBLIC_DAWAI_CHECK_ENABLED=true
NEXT_PUBLIC_VOICE_ASSISTANT_ENABLED=true
# ASSISTANT_PROVIDER=extractive answers by quoting approved articles with citations (no model, no key).
